# Copy to /etc/systemd/system/pretzel-server.service, adjust User and paths, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pretzel-server
#
# Listens on :3001 (see index.js). Start before remote-ui; tv-relay is independent.
# Optional LIFX HTTP API proxy: /lifx/* (set token below).
# WiZ bulbs on the LAN: /pretzel/wiz/* (see WIZ_LIGHTS below).
# Tuya smart switches on the LAN (tinytuya) or via Tuya Cloud: /pretzel/tuya/*.

[Unit]
Description=Pretzel Pi API (TTS, volume, weather, LIFX proxy, WiZ, Tuya on :3001)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pretzel/pretzel-server
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# Optional: match repo root VERSION after deploy (see README).
# Environment=PRETZEL_STACK_VERSION=1.24.0
# Optional: Settings page / curl admin — must match header from UI or client.
# Environment=PRETZEL_SETTINGS_PASSCODE=change_me
# Optional: git pull repo root (default: parent of this directory).
# Environment=PRETZEL_REPO_ROOT=/home/pi/pretzel
# Optional LIFX Cloud API proxy (/lifx/*):
# Environment=LIFX_API_TOKEN=your_token
# Environment=LIFX_API_URL=https://api.lifx.com/v1
# WiZ bulbs, comma-separated ip:label:room (room = Lounge or Bedroom).
# Default is the lounge bulb below; set to empty to disable WiZ.
# Environment="WIZ_LIGHTS=192.168.1.182:Onion:Lounge"
# Tuya switches. Local control: run the tinytuya wizard in ~/tuya (venv in
# ~/tuya/venv); the defaults below then find it. Cloud credentials (same as
# wyat-ai's TUYA_*) are the fallback and can be left out.
# Environment=TUYA_LOCAL_DEVICES=/home/pi/tuya/devices.json
# Environment=TUYA_LOCAL_PYTHON=/home/pi/tuya/venv/bin/python
# TUYA_SWITCHES is comma-separated deviceId:label:room[:ip]; ip only labels the
# device list. TUYA_API_BASE defaults to https://openapi.tuyaus.com.
# Environment=TUYA_CLIENT_ID=your_access_id
# Environment=TUYA_CLIENT_SECRET=your_access_secret
# Environment=TUYA_API_BASE=https://openapi.tuyaus.com
# Environment="TUYA_SWITCHES=your_device_id:Switch:Lounge:192.168.1.188"

[Install]
WantedBy=multi-user.target
